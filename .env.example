# Environment: dev | staging | prod
ENV=dev

# Enables dev tools like the X-Debug-Firebase-Uid header shim and the
# insights /refresh endpoint. MUST be false in prod.
DEV_TOOLS_ENABLED=true

# Postgres async URL
DATABASE_URL=postgresql+asyncpg://khushhal:khushhal@localhost:5432/khushhal

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Firebase Admin SDK service account JSON (single-line JSON string).
# Leave blank in dev to fall back to the X-Debug-Firebase-Uid shim.
FIREBASE_CREDENTIALS_JSON=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
